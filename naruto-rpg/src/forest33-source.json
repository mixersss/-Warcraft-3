\",UD,null,\"Each team starts with a scroll. It may either be an Earth or Heaven scroll. You must have both towards the end of this exam to enter the tower! Entering into the tower is not permitted until the last 2 minutes. In the meantime, I suggest you train yourselves for what comes next! Go now!\",0,10.,false)\ncall RemoveLocation(UD)\ncall TriggerSleepAction(2.75)\ncall SetUnitAnimation(ZH,\"stand\")\ncall TriggerSleepAction(6.)\ncall CinematicFadeBJ(1,3.,\"ReplaceableTextures\\\\CameraMasks\\\\Black_mask.blp\",0,0,0,0)\ncall TriggerSleepAction(4.)\ncall RemoveUnit(ZH)\ncall DestroyFogModifier(bj_lastCreatedFogModifier)\ncall SetTerrainFogExBJ(0,3200.,4500.,.0,60.,80.,80.)\ncall TriggerExecute(X_V)\ncall SetTimeOfDay(.0)\ncall PauseAllUnitsBJ(false)\ncall CinematicFadeBJ(0,1.5,\"ReplaceableTextures\\\\CameraMasks\\\\Black_mask.blp\",0,0,0,0)\ncall ForForce(bj_FORCE_ALL_PLAYERS,\nfunction TMX)\ncall ForForce(bj_FORCE_ALL_PLAYERS,\nfunction TPX)\ncall ForForce(bj_FORCE_ALL_PLAYERS,\nfunction TSX)\nset CE=PRV(bj_mapInitialPlayableArea)\ncall ForGroupBJ(CE,\nfunction TTX)\ncall ForGroupBJ(CE,\nfunction TUX)\ncall DestroyGroup(CE)\ncall CinematicModeBJ(false,bj_FORCE_ALL_PLAYERS)\ncall SetUserControlForceOn(bj_FORCE_ALL_PLAYERS)\ncall ClearMapMusic()\ncall StopMusic(false)\ncall TimerDialogDisplay(bj_lastCreatedTimerDialog,false)\ncall StartTimerBJ(V,false,1320.)\ncall CreateTimerDialogBJ(bj_lastStartedTimer,\"Tournament begins in:\")\ncall TimerDialogDisplay(bj_lastCreatedTimerDialog,true)\ncall StartTimerBJ(E,false,1200.)\nset DE=PRV(FJ)\nset FE=PRV(BQ)\nset GE=PRV(CQ)\nset HE=PRV(DQ)\nset JE=PRV(FQ)\nset KE=PRV(QK)\nset LE=PRV(SK)\ncall ForGroupBJ(DE,\nfunction TWX)\ncall ForGroupBJ(FE,\nfunction TYX)\ncall ForGroupBJ(GE,\nfunction TZX)\ncall ForGroupBJ(HE,\nfunction T_X)\ncall ForGroupBJ(JE,\nfunction T0X)\ncall ForGroupBJ(KE,\nfunction T1X)\ncall ForGroupBJ(LE,\nfunction T2X)\ncall DestroyGroup(DE)\ncall DestroyGroup(FE)\ncall DestroyGroup(GE)\ncall DestroyGroup(HE)\ncall DestroyGroup(JE)\ncall DestroyGroup(KE)\ncall DestroyGroup(LE)\ncall EnableTrigger(O1V)\ncall EnableTrigger(RVV)\ncall EnableTrigger(OFV)\ncall DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,20.,\"|c00FF0000YOU DO NOT NEED SCROLLS TO CONTINUE THE GAME|r\")\ncall EnableTrigger(OZV)\ncall ConditionalTriggerExecute(OZV)\ncall EnableTrigger(O_V)\ncall TriggerSleepAction(540.)\ncall DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,20.,\"|c00FF0000REMEMBER TO TURN IN ONLY ONE PAIR OF SCROLLS PER TEAM STARTING AT 2:00! DON'T FORGET!\")\nset AE=GetRandomLocInRect(TK)\ncall CreateNUnitsAtLoc(1,'h012',Player($C),AE,bj_UNIT_FACING)\ncall RemoveLocation(AE)\ncall UnitAddAbility(bj_lastCreatedUnit,'A018')\ncall SetUnitAbilityLevelSwapped('A018',bj_lastCreatedUnit,3)\ncall UnitAddAbility(bj_lastCreatedUnit,'A02D')\ncall SetUnitAbilityLevelSwapped('A02D',bj_lastCreatedUnit,3)\ncall UnitAddAbility(bj_lastCreatedUnit,'ACcr')\ncall UnitAddAbility(bj_lastCreatedUnit,'A028')\nset IR=bj_lastCreatedUnit\ncall EnableTrigger(DWV)\ncall EnableTrigger(O4V)\ncall EnableTrigger(O5V)\ncall EnableTrigger(O6V)\ncall TriggerSleepAction(630.)\ncall DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,20.,\"|c00FF0000YOU DO NOT NEED SCROLLS TO CONTINUE THE GAME|r\")\nendfunction",
